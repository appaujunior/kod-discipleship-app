# Copy to .env.local and fill in from Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Public URL of the app (used in email links). Leave as-is for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Supabase -> Project Settings -> API Keys -> service_role (click Reveal).
# Never prefix this with NEXT_PUBLIC_ and never commit it. Sign-up uses it to create
# accounts while public sign-ups stay disabled in Supabase.
SUPABASE_SERVICE_ROLE_KEY=
